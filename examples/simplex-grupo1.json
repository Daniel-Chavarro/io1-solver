    "constraints": [
      { "name": "vCPU", "coefficients": ["2", "1", "2"], "op": "<=", "rhs": "70" },
      { "name": "RAM", "coefficients": ["1", "2", "1"], "op": "<=", "rhs": "65" },
      { "name": "SSD", "coefficients": ["3", "1", "4"], "op": "<=", "rhs": "110" },
      { "name": "Licencias BD", "coefficients": ["0", "1", "0"], "op": "<=", "rhs": "30" }
    ]
  },
  "expected": {
    "simplex": { "status": "optimal", "objective_value": "1575" },
    "big_m": { "status": "optimal", "objective_value": "1575" }
